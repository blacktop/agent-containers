{
  "name": "TypeScript Agent Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "NODE_VERSION": "${templateOption:nodeVersion}",
      "CLAUDE_CODE_VERSION": "${templateOption:claudeCodeVersion}",
    },
  },
  "features": {
    "ghcr.io/blacktop/agent-containers/firewall:1": {},
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--security-opt=apparmor=docker-default",
    "--tmpfs=/tmp:rw,noexec,nosuid,size=1g,mode=1777",
  ],
  "remoteUser": "dev",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/dev/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitignore_global,target=/home/dev/.gitignore_global,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.codex,target=/home/dev/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gemini,target=/home/dev/.gemini,type=bind,consistency=cached",
    "source=agent-npm-cache-${devcontainerId},target=/home/dev/.npm,type=volume",
    "source=agent-pnpm-store-${devcontainerId},target=/home/dev/.pnpm-store,type=volume",
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "google.gemini-cli-vscode-ide-companion",
        "dbaeumer.vscode-eslint",
        "YoavBls.pretty-ts-errors",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "johnpapa.vscode-peacock",
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "search.useGlobalIgnoreFiles": true,
        "terminal.integrated.defaultProfile.linux": "fish",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
      },
    },
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}",
    "EXA_API_KEY": "${localEnv:EXA_API_KEY}",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "PNPM_STORE_PATH": "/home/dev/.pnpm-store",
  },
  "postStartCommand": "if [ -f /home/dev/.gitignore_global ]; then git config --global core.excludesFile /home/dev/.gitignore_global; fi; sudo /usr/local/bin/init-firewall.sh; /usr/local/bin/init-gemini-extensions.sh || true; /usr/local/bin/init-mcp.sh || true",
  "waitFor": "postStartCommand",
}
