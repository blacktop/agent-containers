{
  "id": "firewall",
  "version": "1.0.4",
  "name": "Network Firewall Sandbox",
  "description": "Default-deny network firewall with allowlist for AI coding agents. Permits GitHub, npm, PyPI, crates.io, Go modules, Anthropic/OpenAI/Google APIs + ChatGPT/Codex auth, VS Code services, and Zed services.",
  "documentationURL": "https://github.com/blacktop/agent-containers/tree/main/src/features/firewall",
  "licenseURL": "https://github.com/blacktop/agent-containers/blob/main/LICENSE",
  "keywords": ["firewall", "sandbox", "security", "network", "iptables"],
  "options": {
    "allowGithub": {
      "type": "boolean",
      "description": "Allow GitHub (git, API, packages, ghcr.io)",
      "default": true
    },
    "allowNpm": {
      "type": "boolean",
      "description": "Allow npm registry",
      "default": true
    },
    "allowPypi": {
      "type": "boolean",
      "description": "Allow PyPI (Python packages)",
      "default": true
    },
    "allowCrates": {
      "type": "boolean",
      "description": "Allow crates.io (Rust packages)",
      "default": true
    },
    "allowGo": {
      "type": "boolean",
      "description": "Allow Go module proxy",
      "default": true
    },
    "allowAnthropic": {
      "type": "boolean",
      "description": "Allow Anthropic API (Claude)",
      "default": true
    },
    "allowOpenai": {
      "type": "boolean",
      "description": "Allow OpenAI API + ChatGPT/Codex auth endpoints",
      "default": true
    },
    "allowGoogle": {
      "type": "boolean",
      "description": "Allow Google AI API + Gemini auth endpoints",
      "default": true
    },
    "allowVscode": {
      "type": "boolean",
      "description": "Allow VS Code services",
      "default": true
    },
    "allowZed": {
      "type": "boolean",
      "description": "Allow Zed services (zed.dev for remote server downloads)",
      "default": true
    },
    "allowDebian": {
      "type": "boolean",
      "description": "Allow Debian/Ubuntu package repos",
      "default": true
    },
    "customDomains": {
      "type": "string",
      "description": "Additional domains to allow (comma-separated)",
      "default": ""
    }
  },
  "containerEnv": {
    "FIREWALL_ENABLED": "true"
  },
  "privileged": false,
  "capAdd": ["NET_ADMIN", "NET_RAW"],
  "installsAfter": ["ghcr.io/devcontainers/features/common-utils"]
}
