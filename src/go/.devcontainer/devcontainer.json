{
  "name": "Go Agent Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "GO_VERSION": "${templateOption:goVersion}",
      "NODE_VERSION": "${templateOption:nodeVersion}",
      "CLAUDE_CODE_VERSION": "${templateOption:claudeCodeVersion}",
    },
  },
  "features": {
    "ghcr.io/blacktop/agent-containers/firewall:1": {},
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--security-opt=apparmor=docker-default",
    "--tmpfs=/tmp:rw,noexec,nosuid,size=1g,mode=1777",
  ],
  "init": true,
  "remoteUser": "dev",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=agent-claude-config-${devcontainerId},target=/home/dev/.claude,type=volume",
    "source=${localEnv:HOME}/.gitignore_global,target=/home/dev/.gitignore_global,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.codex,target=/home/dev/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gemini,target=/home/dev/.gemini,type=bind,consistency=cached",
    "source=agent-go-cache-${devcontainerId},target=/home/dev/go/pkg,type=volume",
    "source=agent-go-build-cache-${devcontainerId},target=/home/dev/.cache/go-build,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/config,target=/workspace/.git/config,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/hooks,target=/workspace/.git/hooks,type=bind,readonly",
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "google.gemini-cli-vscode-ide-companion",
        "golang.go",
        "eamodio.gitlens",
        "johnpapa.vscode-peacock",
      ],
      "settings": {
        "editor.formatOnSave": true,
        "search.useGlobalIgnoreFiles": true,
        "terminal.integrated.defaultProfile.linux": "fish",
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "package",
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
          },
        },
      },
    },
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "FIREWALL_ENABLED": "${templateOption:enableFirewall}",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "GOPATH": "/home/dev/go",
    "GOROOT": "/usr/local/go",
    "GOMODCACHE": "/home/dev/go/pkg/mod",
    "GOCACHE": "/home/dev/.cache/go-build",
    "NPM_CONFIG_AUDIT": "true",
    "NPM_CONFIG_FUND": "false",
    "NPM_CONFIG_IGNORE_SCRIPTS": "true",
    "NPM_CONFIG_MIN_RELEASE_AGE": "3",
    "NPM_CONFIG_SAVE_EXACT": "true"
  },
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}",
    "EXA_API_KEY": "${localEnv:EXA_API_KEY}",
    "GIT_USER_NAME": "${localEnv:GIT_USER_NAME}",
    "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL}",
    "GITHUB_APP_ID": "${localEnv:GITHUB_APP_ID}",
    "GITHUB_APP_INSTALL_ID": "${localEnv:GITHUB_APP_INSTALL_ID}",
    "GITHUB_APP_KEY_BASE64": "${localEnv:GITHUB_APP_KEY_BASE64}",
    "GITHUB_APP_KEY_PATH": "${localEnv:GITHUB_APP_KEY_PATH}",
    "SSH_DIR": "${localEnv:SSH_DIR}"
  },
  "postStartCommand": "if [ -f /home/dev/.gitignore_global ]; then git config --global core.excludesFile /home/dev/.gitignore_global; fi; if [ -n \"${GIT_USER_NAME:-}\" ]; then git config --global user.name \"$GIT_USER_NAME\"; fi; if [ -n \"${GIT_USER_EMAIL:-}\" ]; then git config --global user.email \"$GIT_USER_EMAIL\"; fi; app_auth_configured=false; if [ -n \"${GITHUB_APP_ID:-}\" ] && [ -n \"${GITHUB_APP_INSTALL_ID:-}\" ] && { [ -n \"${GITHUB_APP_KEY_BASE64:-}\" ] || [ -n \"${GITHUB_APP_KEY_PATH:-}\" ]; }; then /usr/local/bin/init-github-app.sh || echo \"Warning: GitHub App auth failed (continuing anyway)\"; app_auth_configured=true; fi; if [ \"$app_auth_configured\" != \"true\" ]; then key_path=\"\"; if [ -n \"${SSH_DIR:-}\" ] && [ -f \"$SSH_DIR\" ]; then key_path=\"$SSH_DIR\"; elif [ -n \"${SSH_DIR:-}\" ] && [ -d \"$SSH_DIR\" ] && [ -f \"$SSH_DIR/id_ed25519\" ]; then key_path=\"$SSH_DIR/id_ed25519\"; elif [ -f \"/home/dev/.ssh/blacktop-bot\" ]; then key_path=\"/home/dev/.ssh/blacktop-bot\"; elif [ -f \"/home/dev/.ssh/id_ed25519\" ]; then key_path=\"/home/dev/.ssh/id_ed25519\"; fi; if [ -n \"$key_path\" ]; then mkdir -p /home/dev/.ssh; printf \"Host github.com\\n  HostName github.com\\n  User git\\n  IdentityFile %s\\n  IdentitiesOnly yes\\n\" \"$key_path\" > /home/dev/.ssh/config; chmod 600 /home/dev/.ssh/config; fi; fi; if [ \"$FIREWALL_ENABLED\" = \"true\" ]; then sudo /usr/local/bin/init-firewall.sh; fi; /usr/local/bin/init-claude-auth.sh || true; /usr/local/bin/init-gemini-extensions.sh || true; /usr/local/bin/init-mcp.sh || true",
  "waitFor": "postStartCommand",
}
