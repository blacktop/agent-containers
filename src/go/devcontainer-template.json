{
  "id": "go",
  "version": "1.0.9",
  "name": "Go Agent Sandbox",
  "description": "Go development container with AI coding agents (Claude Code, Codex, Gemini CLI) and network firewall sandbox",
  "documentationURL": "https://github.com/blacktop/agent-containers/tree/main/src/go",
  "licenseURL": "https://github.com/blacktop/agent-containers/blob/main/LICENSE",
  "publisher": "blacktop",
  "keywords": [
    "go",
    "golang",
    "claude-code",
    "codex",
    "gemini",
    "sandbox",
    "firewall"
  ],
  "platforms": ["Go"],
  "options": {
    "goVersion": {
      "type": "string",
      "description": "Go version",
      "enum": ["1.24", "1.25"],
      "default": "1.25"
    },
    "nodeVersion": {
      "type": "string",
      "description": "Node.js version (for Claude Code CLI)",
      "enum": ["20", "22", "24"],
      "default": "24"
    },
    "claudeCodeVersion": {
      "type": "string",
      "description": "Claude Code CLI version",
      "default": "latest"
    },
    "enableFirewall": {
      "type": "boolean",
      "description": "Enable network firewall (allowlist only)",
      "default": true
    }
  }
}
