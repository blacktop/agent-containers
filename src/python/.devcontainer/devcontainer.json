{
  "name": "Python Agent Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "PYTHON_VERSION": "${templateOption:pythonVersion}",
      "NODE_VERSION": "${templateOption:nodeVersion}",
      "CLAUDE_CODE_VERSION": "${templateOption:claudeCodeVersion}",
    },
  },
  "features": {
    "ghcr.io/blacktop/agent-containers/firewall:1": {},
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--security-opt=apparmor=docker-default",
    "--tmpfs=/tmp:rw,noexec,nosuid,size=1g,mode=1777",
  ],
  "remoteUser": "dev",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/dev/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitignore_global,target=/home/dev/.gitignore_global,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.codex,target=/home/dev/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gemini,target=/home/dev/.gemini,type=bind,consistency=cached",
    "source=agent-uv-cache-${devcontainerId},target=/home/dev/.cache/uv,type=volume",
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "google.gemini-cli-vscode-ide-companion",
        "ms-python.python",
        "astral-sh.ty",
        "charliermarsh.ruff",
        "ms-python.debugpy",
        "eamodio.gitlens",
        "johnpapa.vscode-peacock",
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "search.useGlobalIgnoreFiles": true,
        "terminal.integrated.defaultProfile.linux": "fish",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit",
          },
        },
      },
    },
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}",
    "EXA_API_KEY": "${localEnv:EXA_API_KEY}",
    "FIREWALL_ENABLED": "${templateOption:enableFirewall}",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "UV_CACHE_DIR": "/home/dev/.cache/uv",
  },
  "postStartCommand": "if [ -f /home/dev/.gitignore_global ]; then git config --global core.excludesFile /home/dev/.gitignore_global; fi; if [ \"$FIREWALL_ENABLED\" = \"true\" ]; then sudo /usr/local/bin/init-firewall.sh; fi; /usr/local/bin/init-gemini-extensions.sh || true; /usr/local/bin/init-mcp.sh || true",
  "waitFor": "postStartCommand",
}
