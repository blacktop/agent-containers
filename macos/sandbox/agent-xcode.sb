;; =============================================================================
;; agent-xcode.sb - macOS Sandbox Profile for AI Agents with Xcode Access
;; =============================================================================
;; Extended sandbox profile that allows Xcode, simulators, and Apple SDKs.
;; Use when the agent needs to build iOS/macOS apps or run simulators.
;;
;; Usage:
;;   sandbox-exec -f agent-xcode.sb -D WORKSPACE=/path/to/workspace -D HOME=$HOME claude
;;
;; Parameters:
;;   WORKSPACE - Directory where agent can read/write files
;;   HOME      - User home directory
;;
;; Additional Access:
;;   - /Applications/Xcode.app
;;   - /Library/Developer/*
;;   - ~/Library/Developer/CoreSimulator
;;   - xcrun, xcodebuild, simctl execution
;; =============================================================================

(version 1)

;; Default deny everything
(deny default)

;; ------------------------------------
;; Process Execution
;; ------------------------------------
;; Allow common shells and utilities
(allow process-exec
    (literal "/usr/bin/env")
    (literal "/bin/sh")
    (literal "/bin/bash")
    (literal "/bin/zsh")
    (literal "/usr/bin/dirname")
    (literal "/usr/bin/basename")
    (literal "/usr/bin/which")
    (literal "/usr/bin/git")
    (literal "/usr/bin/curl")
    (literal "/usr/bin/ssh")
    (literal "/usr/bin/make")
    (literal "/usr/bin/xcodebuild")
    (literal "/usr/bin/xcrun")
    (literal "/usr/bin/xcode-select")
    (literal "/usr/bin/instruments")
    (literal "/usr/bin/codesign")
    (literal "/usr/bin/security"))

;; Allow Node.js (for Claude Code, Codex, Gemini)
(allow process-exec
    (subpath "/usr/local/bin")
    (subpath "/opt/homebrew/bin")
    (subpath "/opt/homebrew/Cellar"))

;; Allow Xcode and developer tools
(allow process-exec
    (subpath "/Applications/Xcode.app")
    (subpath "/Library/Developer"))

;; Allow process forking
(allow process-fork)

;; ------------------------------------
;; Workspace Access (Parameterized)
;; ------------------------------------
(allow file-read* file-write* file-ioctl
    (subpath (param "WORKSPACE")))

(allow file-write-create file-write-data file-write-flags
    file-write-mode file-write-owner file-write-setugid
    file-write-times file-write-unlink
    (subpath (param "WORKSPACE")))

;; ------------------------------------
;; System Libraries (Read-Only)
;; ------------------------------------
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/usr/local/lib")
    (subpath "/opt/homebrew/lib")
    (subpath "/opt/homebrew/Cellar")
    (subpath "/System/Library/Frameworks")
    (subpath "/System/Library/PrivateFrameworks")
    (subpath "/System/Library/CoreServices")
    (literal "/dev/null")
    (literal "/dev/urandom")
    (literal "/dev/random")
    (literal "/dev/tty"))

;; Dyld cache
(allow file-read*
    (subpath "/System/Volumes/Preboot")
    (literal "/private/var/db/dyld/dyld_shared_cache_arm64e")
    (literal "/private/var/db/dyld/dyld_shared_cache_x86_64"))

;; ------------------------------------
;; Xcode and Developer Tools
;; ------------------------------------
;; Xcode.app read access
(allow file-read*
    (subpath "/Applications/Xcode.app")
    (subpath "/Applications/Xcode-beta.app"))

;; Developer directory
(allow file-read*
    (subpath "/Library/Developer"))

;; System SDKs
(allow file-read*
    (subpath "/System/Library/SDKSettingsPlistFiles")
    (subpath "/System/Cryptexes"))

;; ------------------------------------
;; Developer Config and Caches
;; ------------------------------------
;; Allow read/write to developer directories
(allow file-read* file-write*
    (subpath (string-append (param "HOME") "/Library/Developer"))
    (subpath (string-append (param "HOME") "/Library/Caches/com.apple.dt.Xcode"))
    (subpath (string-append (param "HOME") "/Library/Caches/org.swift.swiftpm")))

;; CoreSimulator
(allow file-read* file-write*
    (subpath (string-append (param "HOME") "/Library/Developer/CoreSimulator")))

;; Xcode preferences
(allow file-read*
    (subpath (string-append (param "HOME") "/Library/Preferences/com.apple.dt.Xcode.plist")))

;; ------------------------------------
;; Agent Config Directories
;; ------------------------------------
(allow file-read* file-write*
    (subpath (string-append (param "HOME") "/.claude"))
    (subpath (string-append (param "HOME") "/.codex"))
    (subpath (string-append (param "HOME") "/.gemini"))
    (subpath (string-append (param "HOME") "/.npm"))
    (subpath (string-append (param "HOME") "/.cache/node")))

;; ------------------------------------
;; Configuration Files (Read-Only)
;; ------------------------------------
(allow file-read*
    (literal "/etc/hosts")
    (literal "/etc/resolv.conf")
    (literal "/etc/localtime")
    (literal "/etc/ssl/cert.pem")
    (subpath "/etc/ssl/certs")
    (subpath "/private/etc/ssl"))

(allow file-read*
    (subpath "/System/Library/Keychains")
    (subpath "/Library/Keychains"))

;; ------------------------------------
;; Temporary Files
;; ------------------------------------
(allow file-read* file-write*
    (subpath "/private/tmp")
    (subpath "/var/folders")
    (subpath (string-append (param "HOME") "/.Trash")))

(allow file-write-create
    (regex #"^/private/tmp/")
    (regex #"^/var/folders/"))

;; ------------------------------------
;; Network Access (Outbound Only)
;; ------------------------------------
(allow network-outbound
    (remote tcp "*:443"))

(allow network-outbound
    (remote tcp "*:80"))

(allow network-outbound
    (remote udp "*:53")
    (remote tcp "*:53"))

(allow network-outbound
    (remote tcp "*:22"))

(deny network-inbound)

;; ------------------------------------
;; Mach IPC (System Services + Simulator)
;; ------------------------------------
(allow mach-lookup
    (global-name "com.apple.SecurityServer")
    (global-name "com.apple.cfnetwork.AuthBrokerAgent")
    (global-name "com.apple.nsurlsessiond")
    (global-name "com.apple.trustd.agent")
    (global-name "com.apple.trustd")
    (global-name "com.apple.SystemConfiguration.configd")
    (global-name "com.apple.system.logger")
    (global-name "com.apple.system.notification_center")
    (global-name "com.apple.coreservices.launchservicesd")
    ;; Simulator services
    (global-name "com.apple.CoreSimulator.CoreSimulatorService")
    (global-name "com.apple.dt.Xcode.InstallXcodeHelper")
    (global-name-prefix "com.apple.CoreSimulator."))

;; ------------------------------------
;; Sysctl (System Information)
;; ------------------------------------
(allow sysctl-read
    (sysctl-name "hw.machine")
    (sysctl-name "hw.model")
    (sysctl-name "hw.ncpu")
    (sysctl-name "hw.physicalcpu")
    (sysctl-name "hw.logicalcpu")
    (sysctl-name "hw.memsize")
    (sysctl-name "kern.hostname")
    (sysctl-name "kern.osrelease")
    (sysctl-name "kern.ostype")
    (sysctl-name "kern.osversion")
    (sysctl-name "kern.version")
    (sysctl-name-prefix "net."))

;; ------------------------------------
;; Signals
;; ------------------------------------
(allow signal (target self))

;; ------------------------------------
;; EXPLICIT DENIALS (Security Critical)
;; ------------------------------------
(deny file-read* file-write*
    (subpath (string-append (param "HOME") "/.ssh"))
    (subpath (string-append (param "HOME") "/.aws"))
    (subpath (string-append (param "HOME") "/.gnupg"))
    (subpath (string-append (param "HOME") "/.kube"))
    (subpath (string-append (param "HOME") "/Library/Keychains")))

(deny file-write*
    (subpath "/System")
    (subpath "/usr")
    (subpath "/bin")
    (subpath "/sbin")
    (subpath "/Library"))

(deny file-read* file-write*
    (subpath "/Volumes"))

(deny file-read* file-write*
    (regex #".*/Google/Chrome.*")
    (regex #".*/Firefox.*")
    (regex #".*/Safari.*")
    (regex #".*/Chromium.*"))
